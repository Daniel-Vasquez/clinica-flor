---
const DOCTORALIA =
  'https://www.doctoralia.com.mx/flor-gisela-moreno-flores/cirujano-general-proctologo/benito-juarez?utm_id=59944&utm_source=widget-doctor-59944&utm_medium=big_with_calendar&utm_campaign=&utm_content=#highlight-calendar';
---

<section id="contacto" class="py-36 md:py-52 relative overflow-hidden" style="background-color: #f2f0fc;">

  <!-- Blobs de fondo -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="absolute -top-40 right-0 w-[700px] h-[700px] rounded-full bg-[#EF999E]/[0.09] blur-[130px]"></div>
    <div class="absolute bottom-0 -left-40 w-[600px] h-[600px] rounded-full bg-[#67c5d4]/[0.07] blur-[110px]"></div>
  </div>

  <div class="relative max-w-4xl mx-auto px-6 lg:px-12 text-center">

    <!-- Ornamento -->
    <div class="flex items-center justify-center gap-3 mb-8" data-anim="header">
      <div class="h-px w-12 bg-[#EF999E]/50"></div>
      <div class="w-1.5 h-1.5 rounded-full bg-[#EF999E]/70"></div>
      <div class="h-px w-12 bg-[#EF999E]/50"></div>
    </div>

    <!-- Título principal -->
    <h2
      class="font-heading text-[#1a1830] text-5xl md:text-6xl lg:text-7xl xl:text-8xl leading-[1.05] mb-8"
      data-anim="header"
    >
      ¡Da el primer paso<br />
      <em class="text-[#EF999E]">hacia tu bienestar!</em>
    </h2>

    <!-- Subtítulo -->
    <p class="text-[#4b528a] text-lg md:text-xl leading-relaxed max-w-xl mx-auto mb-14" data-anim="up">
      Agenda tu consulta directamente en Doctoralia.<br class="hidden sm:block" />
      Confirmación inmediata y atención personalizada.
    </p>

    <!-- CTA principal -->
    <div class="mb-16" data-anim="up">
      <a
        href={DOCTORALIA}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-3 bg-[#EF999E] text-white font-semibold
               px-10 py-5 rounded-full text-lg
               hover:bg-[#e8878c] hover:shadow-[0_16px_48px_rgba(239,153,158,0.38)]
               transition-all duration-500 ease-in-out"
      >
        Agendar en Doctoralia
        <span class="text-xl" aria-hidden="true">→</span>
      </a>
    </div>

    <!-- Disponibilidad -->
    <div class="flex items-center justify-center gap-2.5 mb-16" data-anim="up">
      <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
      <p class="text-[#4b528a] text-sm">
        Agenda en línea disponible 24 / 7 · Confirmación inmediata
      </p>
    </div>

    <!-- Hospitales -->
    <div class="flex flex-col sm:flex-row gap-4 justify-center" data-anim="up">
      <div
        class="flex items-center gap-3 bg-white/70 border border-[#4b528a]/15
               rounded-2xl px-6 py-4 backdrop-blur-sm"
      >
        <span class="text-[#67c5d4] text-xl shrink-0" aria-hidden="true">🏥</span>
        <div class="text-left">
          <p class="text-[#1a1830] text-sm font-semibold leading-tight">Hospital San Ángel Inn Patriotismo</p>
          <p class="text-[#4b528a] text-xs mt-0.5">Ciudad de México</p>
        </div>
      </div>

      <div
        class="flex items-center gap-3 bg-white/70 border border-[#4b528a]/15
               rounded-2xl px-6 py-4 backdrop-blur-sm"
      >
        <span class="text-[#67c5d4] text-xl shrink-0" aria-hidden="true">🏥</span>
        <div class="text-left">
          <p class="text-[#1a1830] text-sm font-semibold leading-tight">Hospital Star Médica Luna Parc</p>
          <p class="text-[#4b528a] text-xs mt-0.5">Ciudad de México</p>
        </div>
      </div>
    </div>

  </div>
</section>

---
const DOCTORALIA =
  'https://www.doctoralia.com.mx/flor-gisela-moreno-flores/cirujano-general-proctologo/benito-juarez?utm_id=59944&utm_source=widget-doctor-59944&utm_medium=big_with_calendar&utm_campaign=&utm_content=#highlight-calendar';
---

<section id="contacto" class="py-32 md:py-44 relative overflow-hidden" style="background-color: #f2f0fc;">
  <!-- Blobs decorativos suaves en light -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="absolute -top-40 right-0 w-[600px] h-[600px] rounded-full bg-[#EF999E]/[0.07] blur-[120px]"></div>
    <div class="absolute bottom-0 -left-40 w-[500px] h-[500px] rounded-full bg-[#67c5d4]/[0.06] blur-[100px]"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-12">

    <!-- Header -->
    <div class="mb-20" data-anim="header">
      <!-- Ornamento -->
      <div class="flex items-center gap-3 mb-5">
        <div class="h-px w-10 bg-[#EF999E]/50"></div>
        <div class="w-1.5 h-1.5 rounded-full bg-[#EF999E]/70"></div>
        <div class="h-px w-10 bg-[#EF999E]/50"></div>
      </div>
      <h2 class="font-heading text-[#1a1830] text-4xl md:text-5xl lg:text-6xl">
        ¡Da el primer paso<br />
        <em class="text-[#EF999E]">hacia tu bienestar!</em>
      </h2>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-16 lg:gap-24">

      <!-- Izquierda: info de contacto -->
      <div data-anim="left">
        <p class="text-[#4b528a] text-lg leading-loose mb-10">
          Agenda tu cita en línea a través de Doctoralia o envíanos un mensaje.
          Respondemos en menos de 24 horas con orientación personalizada.
        </p>

        <a
          href={DOCTORALIA}
          target="_blank"
          rel="noopener noreferrer"
          class="btn-primary mb-10 w-full justify-center sm:w-auto"
        >
          Agendar en Doctoralia →
        </a>

        <div class="space-y-4 mb-10">
          <p class="text-[#4b528a] text-xs uppercase tracking-widest font-semibold">
            Consultorios disponibles en:
          </p>

          <div class="flex items-start gap-3">
            <span class="text-[#67c5d4] mt-0.5 shrink-0">🏥</span>
            <div>
              <p class="text-[#1a1830] text-sm font-semibold">Hospital San Ángel Inn Patriotismo</p>
              <p class="text-[#4b528a] text-xs">Ciudad de México</p>
            </div>
          </div>

          <div class="flex items-start gap-3">
            <span class="text-[#67c5d4] mt-0.5 shrink-0">🏥</span>
            <div>
              <p class="text-[#1a1830] text-sm font-semibold">Hospital Star Médica Luna Parc</p>
              <p class="text-[#4b528a] text-xs">Ciudad de México</p>
            </div>
          </div>
        </div>

        <div class="flex items-center gap-3">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse shrink-0"></span>
          <p class="text-[#4b528a] text-sm">
            Agenda en línea disponible 24/7 · Confirmación inmediata
          </p>
        </div>
      </div>

      <!-- Derecha: formulario -->
      <form data-anim="right" class="space-y-6" action="#" method="POST">
        <div class="grid grid-cols-2 gap-5">
          <div>
            <label for="nombre" class="field-label">Nombre</label>
            <input id="nombre" name="nombre" type="text" placeholder="Tu nombre" required class="field-input" />
          </div>
          <div>
            <label for="apellido" class="field-label">Apellido</label>
            <input id="apellido" name="apellido" type="text" placeholder="Tu apellido" required class="field-input" />
          </div>
        </div>

        <div class="grid grid-cols-2 gap-5">
          <div>
            <label for="email" class="field-label">Correo electrónico</label>
            <input id="email" name="email" type="email" placeholder="tu@correo.com" required class="field-input" />
          </div>
          <div>
            <label for="telefono" class="field-label">Teléfono</label>
            <input id="telefono" name="telefono" type="tel" placeholder="+52 55 0000 0000" class="field-input" />
          </div>
        </div>

        <div>
          <label for="padecimiento" class="field-label">
            Motivo de consulta&nbsp;<span class="text-[#7d84b2] normal-case font-normal">(opcional)</span>
          </label>
          <select id="padecimiento" name="padecimiento" class="field-input">
            <option value="">Selecciona un padecimiento…</option>
            <option value="hemorroides">Hemorroides</option>
            <option value="fisuras">Fisuras anales</option>
            <option value="fistula">Fístula anal</option>
            <option value="otro">Otro / No lo sé</option>
          </select>
        </div>

        <div>
          <label for="mensaje" class="field-label">
            Mensaje&nbsp;<span class="text-[#7d84b2] normal-case font-normal">(opcional)</span>
          </label>
          <textarea
            id="mensaje"
            name="mensaje"
            rows={4}
            placeholder="Cuéntame brevemente tu situación o pregunta…"
            class="field-input resize-none"
          ></textarea>
        </div>

        <div class="flex items-start gap-3 pt-1">
          <input id="privacidad" name="privacidad" type="checkbox" required class="mt-0.5 w-4 h-4 rounded accent-[#67c5d4] shrink-0" />
          <label for="privacidad" class="text-[#4b528a] text-xs leading-relaxed">
            Acepto el
            <a href="/privacidad" class="text-[#67c5d4] hover:underline transition-colors duration-300">aviso de privacidad</a>
            y consiento el uso de mis datos para atender mi solicitud.
          </label>
        </div>

        <button type="submit" class="btn-primary w-full justify-center">
          Enviar mensaje →
        </button>
      </form>
    </div>
  </div>
</section>

<style>
  .field-label {
    @apply block text-[#4b528a] text-[10px] uppercase tracking-widest mb-2 font-semibold;
  }

  .field-input {
    @apply w-full bg-white border border-[#4b528a]/30 rounded-2xl
           px-5 py-3.5 text-[#1a1830] text-sm placeholder-[#7d84b2]
           focus:outline-none focus:border-[#67c5d4] focus:bg-white
           transition-all duration-500 ease-in-out;
  }
</style>

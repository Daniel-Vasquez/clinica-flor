---
// [05] Studio — headquarters & workspace
---

<section id="studio" class="py-24 md:py-36 overflow-hidden" style="background-color: #1e1c2e;">
  <div class="max-w-7xl mx-auto px-6 lg:px-12">

    <!-- Header -->
    <div class="mb-16 reveal">
      <span class="section-number block mb-4">[05]</span>
      <h2 class="font-heading font-bold text-white text-4xl md:text-5xl lg:text-6xl">
        The <em class="not-italic text-[#67c5d4]">Studio.</em>
      </h2>
    </div>

    <!-- Content grid -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 lg:gap-24 items-center">

      <!-- Left: info -->
      <div class="reveal">
        <p class="text-[#7d84b2] text-lg leading-relaxed mb-8">
          No open-plan office, no layers of management. Just direct access and
          short decision paths — so your project gets the full focus it deserves from
          day one to delivery.
        </p>

        <!-- Location card -->
        <div
          class="bg-[#4b528a]/25 border border-[#4b528a]/50 rounded-2xl p-6 mb-8"
        >
          <div class="flex items-center gap-3 mb-4">
            <span class="text-[#67c5d4] text-lg" aria-hidden="true">📍</span>
            <h3 class="font-heading font-bold text-white text-lg">Headquarters</h3>
          </div>
          <address class="not-italic text-[#7d84b2] text-sm leading-relaxed">
            Weidenstraße 58<br />
            46395 Bocholt, Germany
          </address>
          <p class="font-mono text-xs text-[#4b528a] mt-3">
            51.8336° N · 6.6131° E
          </p>
        </div>

        <!-- Stats pills -->
        <div class="grid grid-cols-3 gap-4 mb-8">
          {[
            { value: '2025', label: 'Founded'  },
            { value: '30+',  label: 'Clients'  },
            { value: 'NRW',  label: 'Region'   },
          ].map(({ value, label }) => (
            <div class="text-center bg-[#4b528a]/20 rounded-2xl py-5 px-3">
              <p class="font-heading font-bold text-3xl text-[#67c5d4]">{value}</p>
              <p class="text-[#7d84b2] text-xs mt-1">{label}</p>
            </div>
          ))}
        </div>

        <p
          class="text-[#7d84b2] text-sm border-l-2 border-[#67c5d4] pl-4 py-1"
        >
          Visits by appointment only.
        </p>
      </div>

      <!-- Right: studio photo placeholder -->
      <div class="relative reveal" style="transition-delay: 120ms;">
        <!-- Main photo -->
        <div class="aspect-[4/5] rounded-2xl overflow-hidden bg-[#4b528a]/25 ring-1 ring-[#4b528a]/40">
          <img
            src="/images/studio/studio-interior.jpg"
            alt="Wibify studio interior in Bocholt"
            class="w-full h-full object-cover"
            loading="lazy"
          />
        </div>

        <!-- Floating location badge -->
        <div
          class="absolute -bottom-4 -left-4 bg-[#67c5d4] text-[#272538]
                 font-bold text-sm px-5 py-3 rounded-xl shadow-2xl"
        >
          Bocholt, NRW 🇩🇪
        </div>

        <!-- Floating metric badge -->
        <div
          class="absolute -top-4 -right-4 bg-[#4b528a] text-white
                 rounded-2xl p-4 shadow-2xl hidden md:block"
        >
          <p class="font-heading font-bold text-2xl text-[#67c5d4]">11+</p>
          <p class="text-[#7d84b2] text-xs">Years coding</p>
        </div>
      </div>
    </div>
  </div>
</section>

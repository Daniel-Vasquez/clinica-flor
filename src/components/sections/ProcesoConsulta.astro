---
const DOCTORALIA =
  'https://www.doctoralia.com.mx/flor-gisela-moreno-flores/cirujano-general-proctologo/benito-juarez?utm_id=59944&utm_source=widget-doctor-59944&utm_medium=big_with_calendar&utm_campaign=&utm_content=#highlight-calendar';

interface Paso {
  numero:      string;
  titulo:      string;
  descripcion: string;
  detalles:    string[];
}

const pasos: Paso[] = [
  {
    numero:      '01',
    titulo:      'Agenda tu cita',
    descripcion: 'Reserva tu consulta de forma rápida y sencilla a través de Doctoralia, disponible las 24 horas. Recibirás confirmación y recordatorio automático.',
    detalles:    ['Agenda en línea 24/7', 'Confirmación inmediata', 'Sin filas ni esperas', 'Pago seguro'],
  },
  {
    numero:      '02',
    titulo:      'Primera consulta',
    descripcion: 'La Dra. Flor te atenderá personalmente. Realizará un historial clínico completo, evaluación física y, si es necesario, estudios diagnósticos.',
    detalles:    ['Historial clínico completo', 'Exploración física', 'Diagnóstico preciso', 'Trato confidencial'],
  },
  {
    numero:      '03',
    titulo:      'Plan de tratamiento',
    descripcion: 'Recibirás un plan personalizado que prioriza las opciones menos invasivas: cambios de hábitos, medicación o procedimientos de consultorio antes que la cirugía.',
    detalles:    ['Opciones personalizadas', 'Alternativas a la cirugía', 'Explicación clara', 'Sin presiones'],
  },
  {
    numero:      '04',
    titulo:      'Seguimiento y recuperación',
    descripcion: 'El acompañamiento continúa después del tratamiento. La Dra. Flor monitorea tu progreso para garantizar una recuperación completa y prevenir recidivas.',
    detalles:    ['Citas de seguimiento', 'Monitoreo del progreso', 'Ajuste del tratamiento', 'Orientación continua'],
  },
];
---

<section id="proceso" class="py-32 md:py-44 overflow-hidden relative" style="background-color: #ffffff;">
  <!-- Blobs decorativos muy sutiles en light -->
  <div aria-hidden="true" class="pointer-events-none absolute inset-0 overflow-hidden">
    <div class="absolute -top-40 right-0 w-[600px] h-[600px] rounded-full bg-[#EF999E]/[0.06] blur-[120px]"></div>
    <div class="absolute -bottom-40 -left-20 w-[500px] h-[500px] rounded-full bg-[#67c5d4]/[0.05] blur-[100px]"></div>
  </div>

  <div class="relative max-w-7xl mx-auto px-6 lg:px-12">

    <!-- Header -->
    <div class="mb-24" data-anim="header">
      <!-- Ornamento -->
      <div class="flex items-center gap-3 mb-5">
        <div class="h-px w-10 bg-[#EF999E]/50"></div>
        <div class="w-1.5 h-1.5 rounded-full bg-[#EF999E]/70"></div>
        <div class="h-px w-10 bg-[#EF999E]/50"></div>
      </div>
      <h2 class="font-heading text-[#1a1830] text-4xl md:text-5xl lg:text-6xl">
        Así funciona tu
        <em class="text-[#67c5d4]">primera consulta.</em>
      </h2>
      <p class="text-[#4b528a] text-lg mt-5 max-w-xl leading-loose">
        Un proceso claro, sin sorpresas. Tu bienestar y comodidad son nuestra prioridad.
      </p>
    </div>

    <!-- Pasos -->
    <div class="divide-y divide-[#4b528a]/15">
      {pasos.map((paso) => (
        <div
          data-anim="step"
          class="group grid grid-cols-1 lg:grid-cols-5 gap-8 py-14 lg:py-16
                 hover:bg-[#f2f0fc] transition-all duration-500 ease-in-out rounded-2xl px-4 -mx-4"
        >
          <!-- Número -->
          <div class="flex items-start gap-4 lg:gap-0 lg:flex-col lg:justify-between lg:col-span-1">
            <span
              class="font-mono text-5xl md:text-6xl font-light leading-none
                     text-[#4b528a]/50 group-hover:text-[#67c5d4]/60 transition-colors duration-500 ease-in-out"
            >
              {paso.numero}
            </span>
          </div>

          <!-- Contenido -->
          <div class="lg:col-span-4 grid grid-cols-1 md:grid-cols-2 gap-10 items-start">
            <div>
              <h3
                class="font-heading text-3xl md:text-4xl text-[#1a1830] mb-5
                       group-hover:text-[#67c5d4] transition-colors duration-500 ease-in-out"
              >
                {paso.titulo}
              </h3>
              <p class="text-[#4b528a] text-base leading-loose">{paso.descripcion}</p>
            </div>

            <ul class="grid grid-cols-2 gap-x-4 gap-y-4 self-center">
              {paso.detalles.map((detalle) => (
                <li class="flex items-center gap-2.5 text-[#4b528a] text-sm">
                  <span
                    class="w-5 h-5 rounded-full flex items-center justify-center shrink-0
                           bg-[#67c5d4]/10 border border-[#67c5d4]/40"
                    aria-hidden="true"
                  >
                    <span class="text-[#67c5d4] text-[10px]">✓</span>
                  </span>
                  {detalle}
                </li>
              ))}
            </ul>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA final -->
    <div class="mt-20 flex flex-col sm:flex-row items-center gap-6" data-anim="up">
      <a href={DOCTORALIA} target="_blank" rel="noopener noreferrer" class="btn-primary">
        Comenzar ahora →
      </a>
      <p class="text-[#4b528a] text-sm">
        Disponible en Hospital San Ángel Inn Patriotismo y Star Médica Luna Parc
      </p>
    </div>

  </div>
</section>

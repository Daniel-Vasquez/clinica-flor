---
// Padecimientos — Scrolling showcase (3 × 100vh sticky) + bio doctora
import ScrollingFeatureShowcase from '../ui/interactive-scrolling-story-component';

const DOCTORALIA =
  "https://www.doctoralia.com.mx/flor-gisela-moreno-flores/cirujano-general-proctologo/benito-juarez?utm_id=59944&utm_source=widget-doctor-59944&utm_medium=big_with_calendar&utm_campaign=&utm_content=#highlight-calendar";
---

<!-- id="padecimientos" para el anchor de navegación -->
<section id="padecimientos" class="bg-[#272538]">

  <!-- ── Scrolling showcase interactivo (3 × 100vh) ── -->
  <ScrollingFeatureShowcase client:load />

  <!-- ── Bio de la Doctora (estática, debajo del showcase) ── -->
  <div class="bg-brand-navy py-20">
    <div class="max-w-7xl mx-auto px-6 lg:px-12">
      <div
        data-anim="up"
        class="grid grid-cols-1 lg:grid-cols-[1fr,2fr] gap-10 lg:gap-16 items-center
               bg-gradient-to-br from-[#4b528a]/30 to-[#4b528a]/10
               border border-[#4b528a]/40 rounded-3xl p-8 md:p-12"
      >
        <!-- Foto -->
        <div class="flex justify-center lg:justify-start">
          <div
            class="relative w-52 h-52 md:w-64 md:h-64 rounded-full overflow-hidden
                   ring-4 ring-[#67c5d4]/30 ring-offset-4 ring-offset-[#272538]
                   bg-[#4b528a]/30"
          >
            <img
              src="/images/profile/dra-flor-moreno.jpg"
              alt="Dra. Flor Moreno — Especialista en Coloproctología"
              class="w-full h-full object-cover object-top"
              loading="lazy"
            />
          </div>
        </div>

        <!-- Texto + CTAs -->
        <div>
          <p class="text-white text-lg md:text-xl leading-relaxed mb-8 border-l-2 border-[#EF999E] pl-5">
            Soy la <strong class="text-[#EF999E]">Dra. Flor Moreno</strong>,
            especialista en Coloproctología con más de
            <strong class="text-white">12 años de experiencia</strong>.
            Me ocupo en que mis pacientes tengan
            <strong class="text-[#67c5d4]">resultados satisfactorios</strong>.
          </p>

          <div class="flex flex-wrap gap-4">
            <a
              href={DOCTORALIA}
              target="_blank"
              rel="noopener noreferrer"
              class="btn-primary"
            >
              Agenda tu cita →
            </a>
            <a href="#doctora" class="btn-outline">Conocer más</a>
          </div>
        </div>
      </div>
    </div>
  </div>

</section>

---
// Por qué elegir a la Dra. Flor — Gooey tabs interactivos
import GooeyPorQueTabs from '../ui/gooey-por-que-tabs';
---

<section id="por-que" class="bg-brand-navy pt-24 md:pt-32 pb-0 scroll-mt-20">

  <!-- Header (estático en Astro, animado con GSAP) -->
  <div class="max-w-7xl mx-auto px-6 lg:px-12 mb-16" data-anim="header">
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
      <div>
        <h2 class="font-heading font-bold text-white text-4xl md:text-5xl lg:text-6xl">
          ¿Por qué elegir a la
          <em class="not-italic text-[#EF999E]">Dra. Flor?</em>
        </h2>
      </div>
      <div class="flex items-end">
        <p class="text-[#7d84b2] text-lg leading-relaxed">
          Tu bienestar merece un especialista de confianza. Estos son los valores
          que guían cada consulta y cada tratamiento.
        </p>
      </div>
    </div>
  </div>

  <!-- Gooey tabs React (client:load para hidratación inmediata) -->
  <GooeyPorQueTabs client:load />

</section>

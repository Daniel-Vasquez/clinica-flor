---
export interface Props {
  name:     string;
  tags:     string[];
  year:     string;
  image:    string;
  href?:    string;
  featured?: boolean;
}

const { name, tags, year, image, href = '#', featured = false } = Astro.props;
---

<a
  href={href}
  class:list={[
    'group relative block overflow-hidden rounded-2xl',
    'bg-[#4b528a]/20 border border-[#4b528a]/40',
    'hover:border-[#67c5d4]/50 transition-all duration-500',
  ]}
  aria-label={`View project: ${name}`}
>
  <!-- Thumbnail -->
  <div class:list={['overflow-hidden', featured ? 'aspect-[16/9]' : 'aspect-[16/10]']}>
    <img
      src={image}
      alt={name}
      class="w-full h-full object-cover
             group-hover:scale-[1.04] transition-transform duration-700 ease-out"
      loading="lazy"
    />
  </div>

  <!-- Card footer -->
  <div class="p-5 md:p-6 flex items-center justify-between gap-4">
    <div>
      <h3
        class="font-heading font-bold text-lg md:text-xl text-white
               group-hover:text-[#67c5d4] transition-colors duration-300 leading-tight"
      >
        {name}
      </h3>
      <div class="flex flex-wrap gap-2 mt-2.5">
        {tags.map((tag) => (
          <span
            class="text-[11px] text-[#7d84b2] bg-[#4b528a]/40 px-3 py-1 rounded-full"
          >
            {tag}
          </span>
        ))}
      </div>
    </div>
    <span class="text-[#4b528a] text-xs font-mono shrink-0">{year}</span>
  </div>

  <!-- Hover arrow badge -->
  <div
    class="absolute top-4 right-4 w-9 h-9 rounded-full
           bg-[#272538]/80 backdrop-blur-sm
           flex items-center justify-center
           opacity-0 group-hover:opacity-100
           scale-75 group-hover:scale-100
           transition-all duration-300"
    aria-hidden="true"
  >
    <span class="text-[#67c5d4] text-base leading-none">↗</span>
  </div>
</a>

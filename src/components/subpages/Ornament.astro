---
// Ornamento coral (línea · punto · línea) usado en todos los encabezados del sitio
export interface Props {
  center?: boolean;
  class?:  string;
}

const { center = false, class: cls = 'mb-5' } = Astro.props;
---

<div class:list={['flex items-center gap-3', center && 'justify-center', cls]} aria-hidden="true">
  <div class="h-px w-10 bg-[#EF999E]/50"></div>
  <div class="w-1.5 h-1.5 rounded-full bg-[#EF999E]/70"></div>
  <div class="h-px w-10 bg-[#EF999E]/50"></div>
</div>

---
import '../styles/global.css';

export interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Wibify — We build digital products for ambitious brands. Websites, branding, software and mobile apps built with precision.',
  ogImage = '/images/og-image.jpg',
} = Astro.props;
---

<!doctype html>
<html lang="en" class="scroll-smooth">
  <head>
    <meta charset="UTF-8" />
    <!-- Anti-FOUC: apply saved theme before CSS paints -->
    <script is:inline>
      (function () {
        try {
          if (localStorage.getItem('theme') === 'light')
            document.documentElement.classList.add('light');
        } catch (_) {}
      })();
    </script>
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Syne:wght@600;700;800&display=swap"
      rel="stylesheet"
    />

    <!-- SEO / Open Graph -->
    <meta property="og:title"       content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image"       content={ogImage} />
    <meta property="og:type"        content="website" />
    <meta name="twitter:card"       content="summary_large_image" />
  </head>
  <body class="bg-brand-navy text-white overflow-x-hidden">
    <slot />

    <!-- ── GSAP + ScrollTrigger animations ── -->
    <script>
      import gsap from 'gsap';
      import { ScrollTrigger } from 'gsap/ScrollTrigger';

      gsap.registerPlugin(ScrollTrigger);

      /* ─────────────────────────────────────────────────────
         Patrón confiable: gsap.set() oculta inmediatamente
         (sin disparar transiciones CSS), luego gsap.to()
         anima hacia el estado visible en el ScrollTrigger.
         Evita el conflicto entre transition-all y gsap.from().
      ───────────────────────────────────────────────────── */

      /* Hero: animaciones CSS propias del componente glassmorphism-trust-hero.tsx */

      /* ── 2. Section headers ── */
      gsap.utils.toArray('[data-anim="header"]').forEach((el) => {
        const e = el as Element;
        gsap.set(e, { opacity: 0, y: 42 });
        ScrollTrigger.create({
          trigger: e, start: 'top 82%', once: true,
          onEnter: () => gsap.to(e, { opacity: 1, y: 0, duration: 0.85, ease: 'power3.out' }),
        });
      });

      /* ── 3. Stagger grids: set() todos primero, to() en onEnter ── */
      gsap.utils.toArray('[data-anim="stagger"]').forEach((grid) => {
        const g = grid as Element;
        const items = g.querySelectorAll('[data-anim="item"]');
        if (!items.length) return;
        gsap.set(items, { opacity: 0, y: 42 });
        ScrollTrigger.create({
          trigger: g, start: 'top 78%', once: true,
          onEnter: () =>
            gsap.to(items, {
              opacity: 1, y: 0,
              duration: 0.65, stagger: 0.12, ease: 'power3.out',
            }),
        });
      });

      /* ── 4. Slide desde la izquierda ── */
      gsap.utils.toArray('[data-anim="left"]').forEach((el) => {
        const e = el as Element;
        gsap.set(e, { opacity: 0, x: -52 });
        ScrollTrigger.create({
          trigger: e, start: 'top 82%', once: true,
          onEnter: () => gsap.to(e, { opacity: 1, x: 0, duration: 0.88, ease: 'power3.out' }),
        });
      });

      /* ── 5. Slide desde la derecha ── */
      gsap.utils.toArray('[data-anim="right"]').forEach((el) => {
        const e = el as Element;
        gsap.set(e, { opacity: 0, x: 52 });
        ScrollTrigger.create({
          trigger: e, start: 'top 82%', once: true,
          onEnter: () => gsap.to(e, { opacity: 1, x: 0, duration: 0.88, ease: 'power3.out' }),
        });
      });

      /* ── 6. Fade-up genérico ── */
      gsap.utils.toArray('[data-anim="up"]').forEach((el) => {
        const e = el as Element;
        gsap.set(e, { opacity: 0, y: 38 });
        ScrollTrigger.create({
          trigger: e, start: 'top 82%', once: true,
          onEnter: () => gsap.to(e, { opacity: 1, y: 0, duration: 0.8, ease: 'power3.out' }),
        });
      });

      /* ── 7. Pasos del proceso ── */
      gsap.utils.toArray('[data-anim="step"]').forEach((step) => {
        const s = step as Element;
        gsap.set(s, { opacity: 0, x: -36 });
        ScrollTrigger.create({
          trigger: s, start: 'top 85%', once: true,
          onEnter: () => gsap.to(s, { opacity: 1, x: 0, duration: 0.75, ease: 'power3.out' }),
        });
      });

      /* ── 8. Items del FAQ (stagger grupal) ── */
      const faqItems = document.querySelectorAll('[data-anim="faq"]');
      if (faqItems.length) {
        gsap.set(faqItems, { opacity: 0, y: 26 });
        ScrollTrigger.create({
          trigger: faqItems[0], start: 'top 80%', once: true,
          onEnter: () =>
            gsap.to(faqItems, {
              opacity: 1, y: 0,
              duration: 0.5, stagger: 0.09, ease: 'power3.out',
            }),
        });
      }
    </script>
  </body>
</html>
